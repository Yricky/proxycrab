{
  "name": "proxy-crab-t",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:tauri",
    "build:tauri": "vue-tsc --noEmit && vite build --mode tauri",
    "build:cli": "vue-tsc --noEmit && vite build --mode cli",
    "test:unit": "node --experimental-strip-types --test src/utils/*.test.mts",
    "test:column-groups": "node --experimental-strip-types --test src/utils/column-groups.test.mts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "monaco-editor": "^0.56.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.41",
    "vue-icons-plus": "^0.1.9"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
