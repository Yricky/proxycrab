{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proxy-crab-t",
  "version": "0.1.0",
  "identifier": "me.yricky.proxycrab",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProxyCrab",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../skills/proxycrab/SKILL.md": "skills/proxycrab/SKILL.md",
      "../skills/proxycrab/references/": "skills/proxycrab/references/",
      "../skills/proxycrab/scripts/": "skills/proxycrab/scripts/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
